# Supabase transaction pooler (port 6543) used at runtime
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true"
# Supabase session pooler (port 5432) used by prisma migrate
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# Secret used by NextAuth to sign sessions
AUTH_SECRET=""
# Public base URL of the app
NEXTAUTH_URL="http://localhost:3000"

# Stream Chat public API key
NEXT_PUBLIC_STREAM_API_KEY=""
# Stream Chat API secret (server only)
STREAM_API_SECRET=""

# Razorpay key id
RAZORPAY_KEY_ID=""
# Razorpay key secret
RAZORPAY_KEY_SECRET=""
# Razorpay webhook signing secret
RAZORPAY_WEBHOOK_SECRET=""
# Membership price in paise
MEMBERSHIP_AMOUNT_PAISE=50000

# Cloudflare R2 S3 endpoint, https://<account>.r2.cloudflarestorage.com
R2_ENDPOINT=""
# R2 access key id
R2_ACCESS_KEY_ID=""
# R2 secret access key
R2_SECRET_ACCESS_KEY=""
# R2 bucket name
R2_BUCKET=""
# Public base URL serving the bucket
R2_PUBLIC_URL=""

# Support phone number shown to members
NEXT_PUBLIC_SUPPORT_PHONE=""

# Seed: super admin username
SUPERADMIN_USERNAME=""
# Seed: super admin password
SUPERADMIN_PASSWORD=""
