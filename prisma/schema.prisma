// Prisma Schema for Matrimony App

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Gender {
  BRIDE
  GROOM
}

model Profile {
  id               String   @id @default(cuid())
  userId           String   @unique
  user             User     @relation(fields: [userId], references: [id])
  
  // Personal Info
  fullName         String
  gender           Gender
  dateOfBirth      DateTime
  height           String      // e.g., "5'8\""
  
  // Professional Info
  education        String
  profession       String
  salary           String?     // Optional
  
  // Community Info
  location         String
  community        String      // Caste
  subCaste         String?     // Optional
  hasHoroscope     Boolean
  
  // Contact Info
  parentContact    String
  
  // Photos
  profilePhoto     String      // URL/path - mandatory
  additionalPhotos String[]    // Array of URLs/paths
  
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model Favorite {
  id        String   @id @default(cuid())
  userId    String
  profileId String
  createdAt DateTime @default(now())

  @@unique([userId, profileId])
}

model Dismissed {
  id        String   @id @default(cuid())
  userId    String
  profileId String
  createdAt DateTime @default(now())

  @@unique([userId, profileId])
}

enum UserStatus {
  PENDING_PAYMENT
  PENDING_PROFILE
  PENDING_REVIEW
  ACTIVE
  REJECTED
  SUSPENDED
}

model User {
  id           String     @id @default(cuid())
  phoneNumber  String     @unique
  passwordHash String
  displayName  String
  status       UserStatus @default(PENDING_PAYMENT)
  approvedAt   DateTime?
  expiresAt    DateTime?
  profile      Profile?
  payments     Payment[]
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

enum PaymentMethod {
  RAZORPAY
  MANUAL
}
enum PaymentStatus {
  CREATED
  PAID
  FAILED
}

model Payment {
  id                String        @id @default(cuid())
  userId            String
  user              User          @relation(fields: [userId], references: [id])
  amountPaise       Int
  method            PaymentMethod
  status            PaymentStatus @default(CREATED)
  razorpayOrderId   String?       @unique
  razorpayPaymentId String?       @unique
  markedById        String?       // Staff.id for MANUAL
  failureReason     String?
  createdAt         DateTime      @default(now())
  paidAt            DateTime?
}

model Block {
  id        String   @id @default(cuid())
  blockerId String
  blockedId String
  createdAt DateTime @default(now())
  @@unique([blockerId, blockedId])
}

model ChatThread {
  channelId    String  @id
  starterId    String?
  starterCount Int     @default(0)
  unlocked     Boolean @default(false)
}

enum StaffRole {
  VIEWER
  ADMIN
  SUPER_ADMIN
}

model Staff {
  id           String    @id @default(cuid())
  username     String    @unique
  passwordHash String
  role         StaffRole
  active       Boolean   @default(true)
  createdAt    DateTime  @default(now())
}

model ActivityLog {
  id           String   @id @default(cuid())
  staffId      String
  action       String
  targetUserId String?
  details      Json?
  createdAt    DateTime @default(now())
}

model ErrorLog {
  id        String   @id @default(cuid())
  context   String
  message   String
  details   Json?
  createdAt DateTime @default(now())
}
